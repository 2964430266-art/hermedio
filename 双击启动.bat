@echo off
:: 设置系统编码为 UTF-8 避免中文乱码
chcp 65001 >nul
title Hermedio Lofi Room

:: ==========================================
:: 【配置自定义端口】
:: 如果 3010 端口也被占用了，请在这里把下面的 3010 改成其他数字（如 3011, 8080 等）
:: ==========================================
set PORT=3010

echo ====================================================
echo   正在自动启动 Hermedio Lofi Room 音乐软件...
echo   服务将运行在自定义端口: %PORT% (避免冲突)
echo   正在以【精简桌面客户端模式】拉起应用窗口...
echo ====================================================

cd /d "%~dp0"

:: 启动一个后台辅助进程等待 2.5 秒，服务器就绪后再自动拉起 Edge 极简应用模式
:: --app 标志会隐藏浏览器的地址栏、多标签页栏和插件栏，完美呈现原生桌面软件外观
start /min "" cmd /c "timeout /t 3 /nobreak >nul && start msedge --app=http://localhost:%PORT%"

:: 在当前主窗口运行服务，持续输出控制台运行状态
npm run dev
pause
